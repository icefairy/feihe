<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      输入法服务必须带 BIND_INPUT_METHOD 权限，否则系统设置里根本看不到它。
      exported=true 是必须的：系统进程要能绑定这个服务。

      android:settingsActivity 是**系统设置的入口**：系统「输入法 → 飞鹤 → 设置」
      读的就是这个属性。不写的话那一层不会显示设置入口，用户只能自己找我们。
    -->
    <!-- 语音输入：按住麦克风时录音。危险权限，首次使用要在设置页授权。
         不声明的话 AudioRecord 直接抛 SecurityException，而不是"没声音"。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      短信验证码：**默认不读**。设置页里「从短信读取验证码」默认关，打开时才申请
      这个权限，而且只在「当前输入框像验证码框」时读最近 10 分钟的短信，取到 4-8 位
      数字就把正文丢掉（见 clip/SmsOtp.kt 的三道闸）。

      声明在 manifest 里是必须的：不声明的话 requestPermissions 直接返回拒绝，
      连授权框都弹不出来。
    -->
    <uses-permission android:name="android.permission.READ_SMS" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <service
            android:name=".FeiheIme"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:settingsActivity="com.feihe.ime.SettingsActivity">

            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <!-- 子类型描述（中文拼音）。没有这个文件，输入法能装上但列表里是空白。 -->
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!--
          设置页。三个入口都指向它：键盘状态条上的齿轮、系统设置里的「设置」、桌面图标。
          桌面图标（MAIN/LAUNCHER）是刻意加的——输入法装完不会自动出现在桌面上，
          用户想找设置时第一反应是翻应用列表。
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/Theme.Feihe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
