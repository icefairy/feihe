# Gradle / AGP 产物
.gradle/
.kotlin/
build/
app/build/

# 本机路径，不进库
local.properties

# ASR 模型（79 MB）不进库：用 tools/fetch_asr_model.py 拉，SHA256 钉住。
app/src/main/assets/asr/

# sherpa-onnx 原生库（31 MB）+ VAD 模型不进库：和上面同一个理由，
# 用 tools/fetch_sherpa_libs.py 拉。它们是构建输入，不是源码。
# 注意 jniLibs 下还有 build.gradle.kts 生成的 libfeihe_android.so（走 build/ 目录，
# 不在这个路径），所以这里可以整目录排除而不误伤引擎 .so。
app/src/main/jniLibs/arm64-v8a/libonnxruntime.so
app/src/main/jniLibs/arm64-v8a/libsherpa-onnx-*.so
app/src/main/assets/silero_vad.onnx

# IDE
.idea/
*.iml
.DS_Store

# Rust 引擎的构建产物（cargo 自己的 target 目录，几十 MB）
jni/target/
