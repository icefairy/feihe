# ── 构建产物 ────────────────────────────────────────────────────
/target
# tools/ 下是独立的测试用 crate，各有自己的 target
/tools/*/target
# 安装包输出目录（Feihe-Setup-*.exe，每次 build_setup.ps1 都会重新生成）
/dist
__pycache__/

# 构建/部署产生的备份 DLL（register.cmd 在 DLL 被占用时会生成）
*.old
*.old-*

# ── 生成器下载缓存（只留在本地，不进版本库）──────────────────────
# 全部集中在仓库根的 `cache/` 目录（2026-11-07 从根目录挪进去）——
# 以前那些下划线前缀的大文件散在根目录，和源码混在一起，看目录一眼分不清
# 哪些是「产品的一部分」、哪些只是下载缓存。现在只有 cache/ 一个入口。
# _icebase.yaml / _ice8105.yaml  雾凇拼音原始词表，最大 16MB，走 ghproxy 镜像可重下
# _unihan.zip                    自然码辅助码数据源，**目前无法重下**，务必保留在本地
# _ids.txt                       早期按 IDS 推小鹤形码用的，已弃用（改成官方码），可删
# _luna.yaml / _kmandarin.txt    早期试数据源留下的死文件，无人引用
#
# 注意：小鹤官方形码缓存在 tools/xhup_cache.txt，那个**要进版本库**（是数据源不是缓存）。
#
# 整个 cache/ 都不进版本库（下载缓存 + 本地小工具都在里面）。
/cache/
# 根目录残留的下划线前缀文件也一并忽略：万一哪天又把下载缓存放回根目录，
# 不会被误提交进历史（大文件进了 git 历史很难彻底清掉）。
/_*.py
/_*.ps1
/_*.txt
/_*.yaml
/_*.yml
/_*.zip
/_*.json

# ── 个人数据 ────────────────────────────────────────────────────
# import_sogou.py 从本机搜狗用户词库导出，含个人打字记录（约 5 万条）。
# 不进版本库：这是隐私数据，一旦提交进历史就很难彻底清掉。
# 缺这个文件不影响编译——build.rs 读不到就跳过，退化成只用基础词库。
/src/user_dict.txt

# ── 本地工具状态 ────────────────────────────────────────────────
# AI 助手的工作记录（每日日志等），属于本地状态，不参与协作。
/.workbuddy-ai/
/.workbuddy/
# HMEM 连接配置，含 apiKey，不进版本库
/.hmem.json

# ── 词表生成器的每次运行报告（随时可重跑，不进版本库）────────────
/tools/wordlists/_review.txt
/tools/wordlists/_dropped.txt
